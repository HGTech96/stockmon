DATABASE_URL=postgresql+psycopg://stockuser:<password>@localhost:5432/stockmon
# Used by the test suite (api/tests/conftest.py). Create once locally with:
#   createdb -O stockuser stockmon_test
TEST_DATABASE_URL=postgresql+psycopg://stockuser:<password>@localhost:5432/stockmon_test

# Origin the Vite dev server runs on -- allowed by CORS so the UI can call the API.
UI_ORIGIN=http://localhost:5173
